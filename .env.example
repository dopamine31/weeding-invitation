# ===== Core =====
# PostgreSQL connection string (docker compose: postgres service)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Secret for signing sessions, QR codes (HMAC), staff cookies. CHANGE IN PRODUCTION (>= 32 random chars).
APP_SECRET=change-me-to-a-long-random-string-in-production
# Public base URL, used in guest links, QR codes and WhatsApp messages
APP_URL=http://localhost:3000
# true (default) = demo login buttons, mock providers allowed. Set to false in production.
DEMO_MODE=true
# Set true only when serving over plain http (e.g. local `next start`) so session cookies are not marked Secure
INSECURE_COOKIES=false

# ===== WhatsApp (mock | fonnte | cloud). Default mock = simulated delivery, no real messages =====
WA_PROVIDER=mock
# Fonnte (UNOFFICIAL gateway, ban risk): https://fonnte.com
FONNTE_TOKEN=
# WhatsApp Cloud API (official Meta): permanent token + phone number id
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
# Shared secret that provider webhooks must send in the x-webhook-secret header (/api/webhooks/whatsapp)
WEBHOOK_SECRET=

# ===== Payments (empty = mock checkout page /pay/:id) =====
MIDTRANS_SERVER_KEY=
# true = production Midtrans, otherwise sandbox
MIDTRANS_PRODUCTION=false
